      else { ADM.err = ''; toast(r.data && r.data.until ? `Засчитано: «${nm}» — подписка до ${payDay(r.data.until)}.` : 'Платёж засчитан.'); }
      admLoad(true, bad);
      return;
    }
    if (e.target.dataset.admf === 'minver') {
      const v = String(new FormData(e.target).get('min') || '').trim();
      if (v && !/^\d+\.\d+\.\d+$/.test(v)) { ADM.err = 'Версия пишется как 2.80.0.'; paintAdmin(); return; }
      if (v && ST.s.version && vcmp(v, ST.s.version) > 0 && !(await rzConfirm(`Версия ${v} новее вашей (${ST.s.version}) — её ещё нет на сервере, и все, включая вас, упрутся в экран обновления. Сохранить?`, { ok: 'Сохранить', danger: true }))) return;
      const r = await admCall('rz_admin_config', { p_key: 'min_version', p_value: v || null });
      if (!r.ok) { ADM.err = r.error; paintAdmin(); return; }
      ADM.err = ''; toast(v ? `Готово: версии ниже ${v} сначала обновятся.` : 'Ограничение по версии снято.');
      A.check().then(take).catch(() => {});
      return;
    }
    if (e.target.dataset.admf !== 'invite' || ADM.loading) return;
    const fd = new FormData(e.target);
    const edition = fd.get('edition') === 'full' ? 'full' : 'sale';   // 3.12: по умолчанию — покупатель
    // 3.15 (S1): дни подписки при вводе кода — только покупателю; 0 — не передаём (старый сервер параметра не знает)
    const subDays = edition === 'sale' ? Math.max(0, Math.min(3650, Math.floor(+fd.get('sub_days') || 0))) : 0;
    const args = { p_note: String(fd.get('note') || '').trim(), p_days: +fd.get('days') || 0, p_role: 'user', p_edition: edition };
    ADM.loading = true; paintAdmin();
    let r = await admCall('rz_admin_invite', subDays ? Object.assign({ p_sub_days: subDays }, args) : args), subLost = false;
    if (!r.ok && subDays && /p_sub_days|PGRST202|not find|без этой функции/i.test(r.error || '')) { r = await admCall('rz_admin_invite', args); subLost = !!r.ok; }   // сервер старый — код без дней
    ADM.loading = false;
    if (!r.ok) { ADM.err = /p_edition|PGRST202|not find|без этой функции/i.test(r.error) ? OLD_ED : r.error; paintAdmin(); return; }
    ADM.fresh = r.data ? Object.assign({ edition }, r.data, subLost ? { sub_days: 0 } : {}) : null; ADM.err = '';
    if (subLost) toast('Сервер старый — дни подписки к коду не добавлены. Обновите сервер («Настроить сервер.cmd») или добавьте дни в «Пользователях», когда человек войдёт.');
    const n = document.getElementById('admNote'); if (n) n.value = '';
    const ed = document.getElementById('admEd'); if (ed) ed.value = 'sale';   // следующий код — снова безопасная сторона
    const sd = document.getElementById('admSub'); if (sd) sd.value = '0';
    ADM.formEd = 'sale';
    admLoad(true);
  });

  // ---------- профиль: «Обо мне» на компьютере ↔ учётка ----------
  function meToLocal(p){
    const ids = { name: 'meName', region: 'meRegion', price: 'mePrice' };
    let changed = false;
    for (const k in ids) { const el = document.getElementById(ids[k]); if (el && typeof p[k] === 'string' && el.value !== p[k]) { el.value = p[k]; changed = true; } }
    if (changed && typeof meApply === 'function') meApply();   // тот же путь, что правка в «Настройках»: тексты подстроятся
  }
  let mePushT = null;
  ['meName', 'meRegion', 'mePrice'].forEach(id => { const el = document.getElementById(id); if (el) el.addEventListener('change', () => {
    clearTimeout(mePushT);
    mePushT = setTimeout(() => {
      // на компьютере «Обо мне» другой учётки — в эту учётку не отправляем (предупреждение и кнопка — во вкладке «Профиль»)
      if (ST.s.state !== 'in' || typeof settings === 'undefined' || foreignMe()) return;
      A.profile(Object.assign({}, settings.me)).catch(ipcErr).then(r => {
        if (r && isStatus(r.status)) take(r.status);
        if (!r || r.ok === false) toast('«Обо мне» не сохранилось в учётке: ' + ((r && r.error) || 'нет ответа сервера') + '. На этом компьютере — сохранено.');
      });
    }, 800);
  }); });
  // после входа: пустое на одной стороне заполняем с другой (новый компьютер — профиль из учётки; старый пользователь — в учётку)
  function meSync(){
    const u = ST.s.user; if (!u || typeof settings === 'undefined' || ST.meSynced === u.id) return;
    ST.meSynced = u.id;
    const loc = settings.me || {}, locOk = !!(String(loc.name || '').trim() && String(loc.region || '').trim()), srvOk = !!(u.name && u.region);
    if (foreignMe()) return;   // «Обо мне» на компьютере — другой учётки: не отправляем и не смешиваем; решает человек кнопкой в «Профиле»
    const push = p => A.profile(p).catch(ipcErr).then(r => {
      if (r && isStatus(r.status) && ST.s.user && ST.s.user.id === u.id) take(r.status);
      if (!r || r.ok === false) toast('«Обо мне» не сохранилось в учётке: ' + ((r && r.error) || 'нет ответа сервера') + '. На этом компьютере всё на месте.');
    });
    const locPrice = String(loc.price || '').trim(), srvPrice = String(u.price || '').trim();
    if (srvOk && !locOk) meToLocal({ name: u.name, region: u.region, price: srvPrice || locPrice });
    else if (locOk && !srvOk) push({ name: loc.name, region: loc.region, price: locPrice || srvPrice });
    // цена — отдельно: пустая на одной стороне берётся с другой (имя и регион при этом не трогаем)
    else if (!locPrice && srvPrice) meToLocal({ price: srvPrice });
    else if (locPrice && !srvPrice) push({ price: locPrice });
  }

  // ---------- состояние ----------
  function paint(){ paintGate(); paintPanel(); paintAdmin(); }
  window.rzAcctPaint = () => paint();   // 3.13: src/sub.js — «Оплатить подписку» меняет экран входа целиком
  // смена учётки или выход: ничего от прошлого человека не остаётся в памяти окна (редакторы, черновики, админка, временный пароль)
  function resetForUser(){
    ST.edit = ''; ST.draft = null; ST.edErr = ''; ST.signBase = null;
    ED.photo = null; ED.gif = {}; ED.zoom = 1;
    ST.nickEdit = false; ST.mottoEdit = false; ST.nickBusy = false;
    ST.wiz = null; ST.pwOpen = false; ST.mailOpen = false; ST.err = '';
    ST.migTried = false; ST.nickMigTried = false; ST.meSynced = null;
    ST.look = null; ST.lookFor = null; ST.lookOld = false;
    keyHave = null;
    TEAM.list = null; TEAM.open = ''; TEAM.at = 0; TEAM.err = ''; TEAM.old = false; TEAM.loading = false; TEAM.gen++;
    ADM.users = null; ADM.invites = null; ADM.err = ''; ADM.fresh = null; ADM.reset = null; ADM.at = 0; ADM.loading = false; ADM.gen++; ADM.copies = null; ADM.pros = null; ADM.proOld = false;
    ADM.pay = null; ADM.payErr = ''; ADM.payOld = false; ADM.formEd = 'sale';
    PB.testers = null; PB.testersOld = false; PB.err = ''; PB.form = { notes: null, aud: '', level: 'normal' };   // 3.20: «Выпуск» прошлой учётки
    clearTimeout(mePushT);   // отложенная отправка «О себе» прошлого человека не должна уйти в новую учётку
    stopBanners();
  }
  function take(s){
    if (!isStatus(s)) return;   // {ok:false,error} без enabled — не статус: экран входа не прячем
    ST.gotStatus = true;
    ST.sRaw = s; if (window.rzPreview) s = window.rzPreview.status(s);   // 4.0: режим покупателя (src/preview.js) — только владелец
    const was = ST.s;
    const wasUid = was.state === 'in' && was.user ? was.user.id : '', nowUid = s.state === 'in' && s.user ? s.user.id : '';
    ST.s = s;
    if (wasUid && wasUid !== nowUid) resetForUser();   // вышли из 'in' или вошла другая учётка
    if ((was.state === 'in') !== (s.state === 'in')) { ST.showPw = false; ST.email = ''; ST.forgot = false; }   // вход/выход — форма входа с чистого листа
    if (s.state === 'in' && s.offline && Date.now() - ST.offlineToast > 6 * 3600000) {
      ST.offlineToast = Date.now();
      toast(`Нет связи с сервером учёток — программа работает без него ещё ${left(s.graceLeft || 0)}.`);
    }
    if (was.state && was.state !== 'in' && s.state === 'in' && was.enabled) { ST.err = ''; ST.invite = ''; }
    if (was.state !== 'in' && s.state === 'in') FILE_FAIL.clear();   // неудачи до входа (без сессии) — не повод 5 минут показывать буквы
    if (s.state === 'in') { ownerCheck(s.user); if (!ST.look || ST.lookFor !== (s.user && s.user.id)) { const l = s.user && lookLocal(s.user.id); ST.look = l ? l.look : null; ST.lookFor = s.user && s.user.id; } setTimeout(lookSync, 0); meSync(); wizMaybe(); if (s.user && s.user.role === 'admin') setTimeout(() => { admLoad(false); pubMaybe(); }, 0); }
    if (s.state === 'invite' && ST.invite && ST.invTried !== ST.invite && !ST.busy) { ST.invTried = ST.invite; setTimeout(() => act(() => A.redeem(ST.invite)), 0); }   // регистрация через Telegram: код уже введён
    window.dispatchEvent(new CustomEvent('rz-acct', { detail: s }));
    paint();
  }
  window.rzAcctRetake = () => { if (ST.sRaw) take(ST.sRaw); };   // 4.0: демо-оплата в режиме покупателя — статус заново
  A.onEvent(s => { if (!isStatus(s)) return; if (s.state !== 'code' && s.state !== 'out') ST.err = ''; take(s); });
  // первый статус: не ответил статусом — повторяем (событие от главного процесса тоже может прийти раньше)
  let statusTries = 0;
  function statusLoad(){
    const again = () => { if (!ST.gotStatus && ++statusTries < 5) setTimeout(statusLoad, 3000); };
    A.status().then(s => { if (isStatus(s)) take(s); else again(); }, again);
  }
  statusLoad();
  setTimeout(() => { ST.slow = true; paintGate(); }, 2500);   // «проверяю вход» показываем, только если проверка затянулась
  // тикающие таймеры (повтор кода, ожидание бота) — раз в секунду, пока виден экран
  setInterval(() => {
    if (!panel.hidden) panel.querySelectorAll('[data-actick="tg"]').forEach(el => { el.textContent = tgText(); });   // привязка Telegram во вкладке
    if (gate.hidden) return;
    gate.querySelectorAll('[data-actick]').forEach(el => {
      if (el.dataset.actick === 'tg') el.textContent = tgText();
      else { el.textContent = resendText(); el.disabled = resendWait() > 0; }
    });
  }, 1000);
  // вернулись в окно после долгого отсутствия — перепроверить (блокировка, сеть)
  let lastFocusCheck = Date.now();
  window.addEventListener('focus', () => { if (ST.s.enabled && Date.now() - lastFocusCheck > 10 * 60000) { lastFocusCheck = Date.now(); A.check().then(take).catch(() => {}); } });
  window.addEventListener('rz-tab', e => { if (e.detail === 'acct') paintPanel(); else if (panel.hidden) stopBanners(); });
  // showTab — общий, перерисовываем панель при её открытии
  if (typeof showTab === 'function') {
    const orig = showTab;
    window.showTab = showTab = function(t, focus){
      orig(t, focus);
      if (t === 'acct') { paintPanel(); teamLoad(false); } else if (panel.hidden) stopBanners();   // ушли с «Профиля» — шапки не крутим
      if (t === 'admin') { paintAdmin(); admLoad(false); pubLoad(); }
    };
  }
})();
