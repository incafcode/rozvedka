  const pwScore = p => { if (!p) return 0; let s = p.length >= 8 ? 1 : 0; if (p.length >= 12) s++; if (/[a-zа-яё]/.test(p) && /[A-ZА-ЯЁ]/.test(p)) s++; if (/\d/.test(p) && /[^\w\s]|_/.test(p)) s++; else if (/\d/.test(p) && p.length >= 10) s++; return Math.min(4, Math.max(p.length >= 8 ? 1 : 0, s)); };

